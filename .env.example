# Database connection string
# For Hostinger MySQL in production:
# Format: mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>
# Example: mysql://u123456789_admin:YourSecretPass@sql123.main-hosting.eu:3306/u123456789_everygyan
DATABASE_URL="mysql://root:password@localhost:3306/everygyan"

# Admin Authentication Secret
JWT_SECRET="super-secret-editorial-jwt-key-change-in-production-12345678"
NEXTAUTH_URL="http://localhost:3000"

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@everygyan.com"
ADMIN_PASSWORD="AdminPassword123!"

# Site Metadata
NEXT_PUBLIC_SITE_NAME="EveryGyan"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_TAGLINE="JOURNALISM • KNOWLEDGE • GLOBAL PERSPECTIVES"
